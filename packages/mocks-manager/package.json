{
  "name": "@dynamic-mock-server/mocks-manager",
  "version": "0.0.1-beta",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@dynamic-mock-server/eslint-config": "workspace:*",
    "@dynamic-mock-server/typescript-config": "workspace:*",
    "@types/node": "22.10.2",
    "fastify": "5.6.2"
  },
  "dependencies": {
    "@dynamic-mock-server/config": "workspace:*",
    "@migudevelop/types-utils": "1.3.0",
    "chokidar": "4.0.3",
    "fast-glob": "3.3.3"
  },
  "peerDependencies": {
    "fastify": "5.6.2"
  }
}
