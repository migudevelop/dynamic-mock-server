{
  "name": "@dynamic-mock-server/mocks-manager",
  "version": "0.1.0-beta",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@dynamic-mock-server/eslint-config": "workspace:*",
    "@dynamic-mock-server/typescript-config": "workspace:*",
    "fastify": "5.6.2"
  },
  "dependencies": {
    "@dynamic-mock-server/config": "workspace:*",
    "chokidar": "4.0.3",
    "fast-glob": "3.3.3",
    "types-guards": "0.1.0"
  },
  "peerDependencies": {
    "fastify": ">=5.0.0"
  },
  "description": "Mocks manager for Dynamic Mock Server — hot-reload file loading, route handling, and response management",
  "keywords": [
    "mock",
    "server",
    "development",
    "testing",
    "api",
    "http",
    "routes",
    "hot-reload",
    "file-loader",
    "fastify"
  ],
  "author": "migudevelop",
  "repository": {
    "type": "git",
    "url": "https://github.com/migudevelop/dynamic-mock-server",
    "directory": "packages/mocks-manager"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
