{
  "name": "@dynamic-mock-server/core",
  "version": "0.0.1-beta",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@dynamic-mock-server/eslint-config": "workspace:*",
    "@dynamic-mock-server/typescript-config": "workspace:*"
  },
  "dependencies": {
    "@dynamic-mock-server/alerts": "workspace:*",
    "@dynamic-mock-server/config": "workspace:*",
    "@dynamic-mock-server/logger": "workspace:*",
    "@dynamic-mock-server/mocks-manager": "workspace:*",
    "chokidar": "4.0.3",
    "fastify": "5.6.2",
    "unconfig": "7.4.1"
  }
}
