{
  "name": "@dynamic-mock-server/logger",
  "version": "0.1.0-beta",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@dynamic-mock-server/eslint-config": "workspace:*",
    "@dynamic-mock-server/typescript-config": "workspace:*"
  },
  "dependencies": {
    "pino": "10.1.0"
  },
  "optionalDependencies": {
    "pino-pretty": "13.1.2"
  },
  "description": "Logger for Dynamic Mock Server — Pino-based structured logging with namespace support",
  "keywords": [
    "mock",
    "server",
    "development",
    "testing",
    "api",
    "http"
  ],
  "author": "migudevelop",
  "repository": {
    "type": "git",
    "url": "https://github.com/migudevelop/dynamic-mock-server",
    "directory": "packages/logger"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
