{
  "name": "dynamic-mock-server",
  "version": "0.1.0-beta",
  "description": "Serve and update API mocks instantly, with hot-reload support for faster development and testing.",
  "main": "index.js",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky install",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter='./packages/*' && changeset publish"
  },
  "keywords": [],
  "engines": {
    "node": ">=18"
  },
  "author": "Miguel Martínez",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "@changesets/cli": "2.27.0",
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@types/node": "24.9.2",
    "eslint-plugin-import": "2.32.0",
    "husky": "8.0.3",
    "lint-staged": "16.2.6",
    "prettier": "3.6.2",
    "tsup": "8.5.1",
    "turbo": "2.6.0",
    "typescript": "5.9.2",
    "eslint": "9.38.0",
    "types-guards": "0.1.0",
    "vitest": "3.2.1"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
